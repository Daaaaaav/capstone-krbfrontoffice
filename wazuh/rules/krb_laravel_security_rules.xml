<!--
  KRB Laravel Application Security Monitoring Rules
  ===============================================================
  Dedicated rule namespace: 100810 - 100817

  These rules match JSON events decoded by the krb-laravel-security
  decoder (wazuh/decoders/krb_laravel_security_decoders.xml).

  The decoded field "message" contains the security event marker
  written by App\Services\SecurityMonitoringService:
    LOGIN_ATTEMPT, LOGIN_FAILED, LOGIN_SUCCESS,
    BRUTE_FORCE_DETECTED, FORM_SUBMIT.

  Severity mapping consistent with the existing Laravel dashboard
  (App\Services\WazuhService::classifySeverity):
    Critical : level >= 12   → BRUTE_FORCE_DETECTED
    High     : level  9-11   → (none currently — reserved)
    Medium   : level  6-8    → LOGIN_FAILED, FORM_SUBMIT anomaly
    Low      : level  1-5    → LOGIN_ATTEMPT, LOGIN_SUCCESS

  The rules below do NOT match the KRB health-check decoder
  (krb-endpoint-checker) — each decoder is a separate namespace.

  Preserved: All rules in krb_app_health_rules.xml (100800-100807)
             are completely untouched by this file.

  Deployment:
    docker exec <wazuh-manager-container> \
      cp /path/to/repo/wazuh/rules/krb_laravel_security_rules.xml \
         /var/ossec/etc/rules/krb_laravel_security_rules.xml
    docker exec <wazuh-manager-container> /var/ossec/bin/wazuh-analysisd -t
    docker restart <wazuh-manager-container>

  Testing (on the manager host):
    echo '{"message":"LOGIN_FAILED","context":{"ip":"1.2.3.4","email":"test@example.com","reason":"invalid_credentials"},"level":300,"level_name":"WARNING","channel":"security","datetime":"2026-08-23T14:00:00+07:00","extra":{}}' \
      | /var/ossec/bin/wazuh-logtest
-->
<group name="krb_security,laravel,authentication,">

  <!-- ──────────────────────────────────────────────────────────
       100810 — Base rule for all Laravel security channel events
       Low (level 3) — informational base; not shown as an alert
       unless a child rule overrides the level.
  ────────────────────────────────────────────────────────────── -->
  <rule id="100810" level="3">
    <decoded_as>krb-laravel-security</decoded_as>
    <field name="channel">security</field>
    <description>KRB Laravel security event.</description>
    <group>krb_security,</group>
  </rule>

  <!-- ──────────────────────────────────────────────────────────
       100811 — Login attempt (informational)
       Level 3 (Low) — normal user activity; low noise baseline.
  ────────────────────────────────────────────────────────────── -->
  <rule id="100811" level="3">
    <if_sid>100810</if_sid>
    <field name="message">LOGIN_ATTEMPT</field>
    <description>KRB: User login attempt from $(context.ip).</description>
    <group>krb_security,authentication,</group>
  </rule>

  <!-- ──────────────────────────────────────────────────────────
       100812 — Single failed login
       Level 6 (Medium) — suspicious but could be a typo.
  ────────────────────────────────────────────────────────────── -->
  <rule id="100812" level="6">
    <if_sid>100810</if_sid>
    <field name="message">LOGIN_FAILED</field>
    <description>KRB: Failed login attempt from $(context.ip). Reason: $(context.reason).</description>
    <group>krb_security,authentication_failed,</group>
  </rule>

  <!-- ──────────────────────────────────────────────────────────
       100813 — Successful login
       Level 3 (Low) — informational; expected normal activity.
  ────────────────────────────────────────────────────────────── -->
  <rule id="100813" level="3">
    <if_sid>100810</if_sid>
    <field name="message">LOGIN_SUCCESS</field>
    <description>KRB: Successful login from $(context.ip).</description>
    <group>krb_security,authentication_success,</group>
  </rule>

  <!-- ──────────────────────────────────────────────────────────
       100814 — Brute-force attack detected
       Level 12 (Critical) — multiple failures from the same IP
       exceeded the 5-attempt threshold in LogFailedLogin.php.
       This maps to the 'critical' severity bucket in WazuhService
       (level >= 12) and will appear as a Critical alert in the
       Manager and IT Officer Security Reports dashboards.
  ────────────────────────────────────────────────────────────── -->
  <rule id="100814" level="12">
    <if_sid>100810</if_sid>
    <field name="message">BRUTE_FORCE_DETECTED</field>
    <description>KRB: Brute-force login attack detected from $(context.ip). Attempts: $(context.attempts).</description>
    <group>krb_security,authentication_failed,brute_force,</group>
  </rule>

  <!-- ──────────────────────────────────────────────────────────
       100815 — Test event (used only during deployment validation)
       Level 5 (Low) — generated by the deployment test command;
       should be ignored in production alerting.
  ────────────────────────────────────────────────────────────── -->
  <rule id="100815" level="5">
    <if_sid>100810</if_sid>
    <field name="message">WAZUH_LARAVEL_TEST_EVENT</field>
    <description>KRB: Laravel-to-Wazuh pipeline test event. Safe to ignore.</description>
    <group>krb_security,test,</group>
  </rule>

  <!-- ──────────────────────────────────────────────────────────
       100816 — Form submission (informational)
       Level 3 (Low) — normal user activity recorded for audit trail.
  ────────────────────────────────────────────────────────────── -->
  <rule id="100816" level="3">
    <if_sid>100810</if_sid>
    <field name="message">FORM_SUBMIT</field>
    <description>KRB: Form submission recorded from $(context.ip).</description>
    <group>krb_security,</group>
  </rule>

  <!-- ──────────────────────────────────────────────────────────
       100817 — Captcha failure (suspicious)
       Level 6 (Medium) — repeated captcha failures may indicate
       an automated attack bypassing the UI.
  ────────────────────────────────────────────────────────────── -->
  <rule id="100817" level="6">
    <if_sid>100812</if_sid>
    <field name="context.reason">captcha_failed</field>
    <description>KRB: Login failed due to captcha verification failure from $(context.ip).</description>
    <group>krb_security,authentication_failed,</group>
  </rule>

</group>
